#!/bin/sh
# ZeroProxy 路由器管理界面的页面 + 数据接口 (在 /cgi-bin/zeroproxy 执行)。
#
# 为什么由这个脚本自己发页面, 而不靠静态目录: 固件之间的文档根/Web 服务差别太大 ——
# uhttpd 的 /www 能用, nginx+fcgiwrap 的固件上静态目录返回 403, 而原厂 nginx (没有
# LuCI) 干脆没有 /cgi-bin/ 这条 location。脚本由 cgi 环节发出, 这几条路都能走。
#
# 输出一律是 JSON: {"ok":true,...} / {"ok":false,"error":"..."}
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

ZP_DIR=/etc/zeroproxy
CLI=/usr/bin/zeroproxy
#: 查询串要在鉴权之前解析 —— 令牌就是从它里面取的
QS="${QUERY_STRING:-}"

# 页面文件在哪: 默认是固件的文档根 (/www/zeroproxy), 兜底 httpd 那条路放在
# /etc/zeroproxy/www/zeroproxy。判据是"文件在不在" —— SCRIPT_FILENAME 有的服务器
# (busybox httpd / fcgiwrap / uhttpd) 给、有的不给, 指望它不如自己找一遍。
ui_page_dir() {
    _derived=""
    if [ -n "${SCRIPT_FILENAME:-}" ]; then
        _derived="$(dirname "$(dirname "$SCRIPT_FILENAME")")/zeroproxy"
    fi
    for _d in "${ZP_PAGE_DIR:-}" "$_derived" /www/zeroproxy "$ZP_DIR/www/zeroproxy"; do
        if [ -n "$_d" ] && [ -f "$_d/index.html" ]; then
            printf '%s' "$_d"
            return 0
        fi
    done
    printf '/www/zeroproxy'
}
PAGE_DIR="$(ui_page_dir)"

header() {
    printf 'Content-Type: application/json; charset=utf-8\r\n'
    printf 'Cache-Control: no-store\r\n'
    printf '\r\n'
}
fail() { header; printf '{"ok":false,"error":"%s"}\n' "$1"; exit 0; }

# 鉴权: 满足任意一条即可
#   ① URL 里带一次性令牌 (?k=…)  —— `zeroproxy ui` 打印的就是它, 顺手种成 cookie
#   ② 已经种下的令牌 cookie
#   ③ 一个有效的 LuCI 会话 (走 LuCI 菜单进来的人)
# 为什么不能只认 ③: GL.iNet 的后台是它自己的 Vue 界面, **不是 LuCI** —— 登录它不会
# 产生 LuCI 会话, 而 LuCI 在 /cgi-bin/luci 是另一个入口。只认 LuCI 的话, 这台设备上
# 页面永远是"未登录"(真机截图就是这么来的)。
TOKFILE=/etc/zeroproxy/ui.token
tok="$(cat "$TOKFILE" 2>/dev/null)"
qk="$(printf '%s' "$QS" | tr '&' '\n' | sed -n 's/^k=//p' | head -n1)"
ck="$(printf '%s' "${HTTP_COOKIE:-}" | tr ';' '\n' | sed -n 's/^ *zp_ui=\(.*\)$/\1/p' | head -n1)"
if [ -n "$tok" ] && [ "$qk" = "$tok" ] && [ "$ck" != "$tok" ]; then
    # Max-Age 一年: 这是"打开过一次就再也不用管"的关键 —— 会话 cookie 一关浏览器就没了,
    # 用户下次打开普通地址又看到"未授权", 只会觉得这东西时好时坏。
    printf 'Set-Cookie: zp_ui=%s; Path=/; Max-Age=31536000; HttpOnly; SameSite=Lax\r\n' "$tok"
fi
ok=""
if [ -n "$tok" ] && { [ "$qk" = "$tok" ] || [ "$ck" = "$tok" ]; }; then ok=1; fi
if [ -z "$ok" ]; then
    sid="$(printf '%s' "${HTTP_COOKIE:-}" | tr ';' '\n' | sed -n 's/^ *sysauth[^=]*=\(.*\)$/\1/p' | head -n1)"
    if [ -n "$sid" ] && command -v ubus >/dev/null 2>&1; then
        # 用会话 id 去问一次: **有效会话**返回 JSON (可能没有 values), **无效会话**打印
        # "Command failed … (Not found)" —— 注意 ubus 这两种情况的退出码都是 0, 只能看文本。
        #
        # 别再用 `ubus -S <sid> call …`: 新版 ubus 的 `-S` 是"简化输出 (给脚本用)", 它
        # **不接受参数** —— 那条命令只会打印一屏用法, 于是判定永远失败, 而"从 LuCI 菜单
        # 点进来"这条路一直是未授权 (真机 GL-MT3000 / OpenWrt 24.10 实测)。旧固件上没人
        # 发现, 是因为那台没有 LuCI。
        _sess="$(ubus call session get "{\"ubus_rpc_session\":\"$sid\"}" 2>&1)"
        case "$_sess" in
            ""|*"Command failed"*) ;;
            *) ok=1 ;;
        esac
    fi
fi

# ---------------------------------------------------------------- 鉴权
# 先服务"页面本身": 界面也由这个脚本发出 —— GL.iNet 这类固件的 80 端口是
# nginx + fcgiwrap, 静态目录不一定在浏览器能访问的位置 (真机上 /www/zeroproxy/
# 直接 403), 而 /cgi-bin/ 一定通 (LuCI 自己就走这条路)。
# 页面代码不含任何机密, 所以这一段不需要登录。
want="$(printf '%s' "$QS" | tr '&' '\n' | sed -n 's/^file=//p' | head -n1)"
# 白名单: 只有这两个脚本名 (perf.js 是那块性能模式表盘)。写死而不是拼路径 —— 这个
# 端点不需要授权就能访问, 拼路径等于开一个任意文件读取。
case "$want" in
    app.js|perf.js)
        printf 'Content-Type: text/javascript; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'
        cat "$PAGE_DIR/$want" 2>/dev/null
        exit 0 ;;
esac
act="$(printf '%s' "$QS" | tr '&' '\n' | sed -n 's/^a=//p' | head -n1)"
if [ -z "$act" ] && [ -z "$want" ]; then
    printf 'Content-Type: text/html; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'
    cat "$PAGE_DIR/index.html" 2>/dev/null
    exit 0
fi


# 页面与脚本本身不需要授权; 只有下面的数据接口要。
[ -n "$ok" ] || fail "未授权 — 在路由器上执行 zeroproxy ui 拿到带令牌的地址"

# ---------------------------------------------------------------- 工具
BODY="$(cat 2>/dev/null || true)"

jval() {
    if command -v jsonfilter >/dev/null 2>&1; then
        printf '%s' "$BODY" | jsonfilter -e "@.$1" 2>/dev/null | head -n1
    else
        printf '%s' "$BODY" | sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1
    fi
}
# 把任意文本塞进 JSON 字符串 (换行转义成 \n, 由前端还原)
jstr() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\r' | awk '{printf "%s\\n", $0}'; }

# **单值**用这个: 同样转义, 但不追加那个尾随换行。
# jstr 是给"多行的 CLI 输出"准备的 —— 它把每行结尾变成字面的 \n, JSON 解出来就是真换行,
# 前端再按换行切分 (动作回执、日志)。用在 base / version / 服务器键这种单值上, 结果是
# 值尾巴上多一个换行 (真机实测: "base":"https://hk.i3.pub:8899\n" —— 界面看不出来, 但
# 值是错的, 排障时对不上)。
jval_s() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\r\n'; }

# 动作名: /cgi-bin/zeroproxy/add → add (PATH_INFO 或 REQUEST_URI 里取最后一段)
action="$act"
if [ -z "$action" ]; then
    action="$(printf '%s' "${PATH_INFO:-}" | sed -e 's#^/*##' -e 's#/.*$##')"
fi
if [ -z "$action" ]; then
    action="$(printf '%s' "${REQUEST_URI:-}" | sed -e 's/[?].*$//' -e 's#/*$##' -e 's#.*/##')"
fi

run_cli() {
    if [ -x "$CLI" ]; then
        out="$("$CLI" "$@" 2>&1)"
        header
        printf '{"ok":true,"message":"%s"}\n' "$(jstr "$out")"
    else
        fail "路由器上找不到 zeroproxy 命令, 请重跑一次安装命令"
    fi
}

case "$action" in
    status)
        core="stopped"
        /etc/init.d/zeroproxy running >/dev/null 2>&1 && core="running"
        # 模式按**现场**报 (设备/表真的在不在), 不看 /dev/net/tun 这个节点 —— 它在某些
        # 固件上存在但内核建不出设备 (真机: 原厂 5.4.281), 那时报 TUN 就是骗人。
        # covered 是"到底接管到哪": 只接管了局域网 TCP 就不能显示成全屋。
        mode="none"
        # 性能模式 (eBPF / dae) 排第一: 它开着的时候 mihomo 是停的, tun 那条判断根本不会命中,
        # 但顺序上先说清楚——"谁在接管"是这一屏最该回答的问题。
        if [ -n "$(pidof dae 2>/dev/null)" ]; then mode="ebpf"
        elif ip link show zp-tun >/dev/null 2>&1; then mode="tun"
        elif nft list table inet zp_router >/dev/null 2>&1; then mode="tproxy"
        elif iptables -t nat -L zp_router >/dev/null 2>&1; then mode="redirect"
        fi
        covered="none"
        [ "$mode" = "ebpf" ] && covered="full"
        [ "$mode" = "tun" ] && covered="full"
        [ "$mode" = "tproxy" ] && covered="lan"
        [ "$mode" = "redirect" ] && covered="lan_tcp"
        # 数据面没探到任何一级时, 把原因也带上 (界面上直接说"为什么")
        why="$(sed -n 's/^why.tun=//p' "$ZP_DIR/caps" 2>/dev/null | head -n1)"
        # IPv6 能不能一并接管: 接不了要显示出来 (局域网设备的 v6 会直接出去)
        ipv6="$(sed -n 's/^ipv6=//p' "$ZP_DIR/caps" 2>/dev/null | head -n1)"
        # 性能模式那几张牌: 能不能开 (cap) / 现在开着吗 (state + 现场 live) / 为什么开不了 /
        # 出口 IP / 正在切换时的最后几行进度。界面上的仪表盘就是照这几个值画的。
        perf_cap="$(sed -n 's/^perf_cap=//p' "$ZP_DIR/caps" 2>/dev/null | head -n1)"
        perf_state="$(sed -n '1p' "$ZP_DIR/perf/state" 2>/dev/null | tr -d '\r\n')"
        perf_why="$(sed -n '1p' "$ZP_DIR/perf/why" 2>/dev/null | tr -d '\r\n')"
        perf_exit="$(sed -n '1p' "$ZP_DIR/perf/exit_ip" 2>/dev/null | tr -d '\r\n')"
        # "正在切" = 说好在切 (state=on) 而 dae 还没起来, 或者进度文件里还没有终态。
        # 界面据此把"进入中"那段动画放下去, 而不是干等。
        perf_busy="0"
        if [ -f "$ZP_DIR/perf/progress" ] && ! grep -q '^DONE=' "$ZP_DIR/perf/progress" 2>/dev/null; then
            perf_busy="1"
        fi
        perf_prog="$(tail -n 3 "$ZP_DIR/perf/progress" 2>/dev/null | tr '\n' '|')"
        # WAN 口的收+发字节数: 表盘上那根针的转速就是它算出来的 —— 真流量才有转速,
        # 拿不到就退回 0 (表针贴怠速), 绝不假装在动。
        wan=0
        _wdev="$(ip route show default 2>/dev/null | awk 'NR==1{print $5}' | head -n1)"
        if [ -n "$_wdev" ] && [ -r "/sys/class/net/$_wdev/statistics/rx_bytes" ]; then
            _rx="$(cat "/sys/class/net/$_wdev/statistics/rx_bytes" 2>/dev/null || echo 0)"
            _tx="$(cat "/sys/class/net/$_wdev/statistics/tx_bytes" 2>/dev/null || echo 0)"
            wan=$(( ${_rx:-0} + ${_tx:-0} ))
        fi
        ver=""
        [ -f "$ZP_DIR/version" ] && ver="$(cat "$ZP_DIR/version" 2>/dev/null)"
        items=""
        for f in "$ZP_DIR"/servers/*.json; do
            [ -f "$f" ] || continue
            base="$(sed -n 's/.*"base"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -n1)"
            did="$(sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -n1)"
            key="$(basename "$f" .json)"
            items="${items:+$items,}{\"key\":\"$(jval_s "$key")\",\"base\":\"$(jval_s "$base")\",\"id\":\"$(jval_s "$did")\"}"
        done
        header
        printf '{"ok":true,"core":"%s","mode":"%s","covered":"%s","why":"%s","ipv6":"%s","client":"%s","wan":"%s","servers":[%s],' \
            "$core" "$mode" "$covered" "$(jstr "$why")" "$ipv6" "$(jval_s "$ver")" "$wan" "$items"
        printf '"perf":{"cap":"%s","state":"%s","why":"%s","exit_ip":"%s","busy":"%s","progress":"%s"}}\n' \
            "$perf_cap" "$perf_state" "$(jstr "$perf_why")" "$(jval_s "$perf_exit")" \
            "$perf_busy" "$(jstr "$perf_prog")"
        ;;
    add)
        url="$(jval url)"
        [ -n "$url" ] || fail "没有收到服务器链接"
        run_cli add "$url"
        ;;
    drop)
        key="$(jval key)"
        [ -n "$key" ] || fail "没有指定要移除的服务器"
        run_cli drop "$key"
        ;;
    toggle)
        on="$(jval on)"
        if [ "$on" = "true" ] || [ "$on" = "1" ]; then run_cli on; else run_cli off; fi
        ;;
    refresh)
        run_cli refresh
        ;;
    perf-on|perf-off)
        # 界面上的那个开关 (跑车仪表盘) 走这里。CLI 自己判断有没有 TTY: 这里没有, 所以它会
        # 后台跑、把进度写进 perf/progress, 界面轮询 status 就能画出"进入中"的动画。
        run_cli perf "${action#perf-}"
        ;;
    update|update-log)
        # 页面上的「更新客户端」按钮走这里 —— LuCI 菜单那个页面是用 cgi 发的 (端口 80),
        # 所以 update 必须在这个 case 里也有一份。**只加在 CLI 与 zpcore 上是不够的**:
        # 真机上点下去就是"未知操作: update" (因为那个页面根本没走 zpcore)。
        run_cli "$action"
        ;;
    log)
        lines="$(logread -e zeroproxy 2>/dev/null | tail -n 60)"
        header
        printf '{"ok":true,"log":"%s"}\n' "$(jstr "$lines")"
        ;;
    *)
        fail "未知操作: $action"
        ;;
esac
