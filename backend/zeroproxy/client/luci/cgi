#!/bin/sh
# ZeroProxy 路由器管理界面的数据接口 (uhttpd 在 /cgi-bin/zeroproxy 执行)。
#
# 为什么不自己起一个监听端口: 路由器上的每一个监听端口都是一个可能被扫的入口。
# 这里复用 uhttpd, 并且**逐次校验 LuCI 会话** —— 只有已登录 LuCI 的浏览器才能
# 拿到数据, 也不需要再发明一套登录。
#
# 输出一律是 JSON: {"ok":true,...} / {"ok":false,"error":"..."}
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

ZP_DIR=/etc/zeroproxy
CLI=/usr/bin/zeroproxy
#: 查询串要在鉴权之前解析 —— 令牌就是从它里面取的
QS="${QUERY_STRING:-}"

header() {
    printf 'Content-Type: application/json; charset=utf-8\r\n'
    printf 'Cache-Control: no-store\r\n'
    printf '\r\n'
}
fail() { header; printf '{"ok":false,"error":"%s"}\n' "$1"; exit 0; }

# 鉴权: 满足任意一条即可
#   ① URL 里带一次性令牌 (?k=…)  —— `zeroproxy ui` 打印的就是它, 顺手种成 cookie
#   ② 已经种下的令牌 cookie
#   ③ 一个有效的 LuCI 会话 (走 LuCI 菜单进来的人)
# 为什么不能只认 ③: GL.iNet 的后台是它自己的 Vue 界面, **不是 LuCI** —— 登录它不会
# 产生 LuCI 会话, 而 LuCI 在 /cgi-bin/luci 是另一个入口。只认 LuCI 的话, 这台设备上
# 页面永远是"未登录"(真机截图就是这么来的)。
TOKFILE=/etc/zeroproxy/ui.token
tok="$(cat "$TOKFILE" 2>/dev/null)"
qk="$(printf '%s' "$QS" | tr '&' '\n' | sed -n 's/^k=//p' | head -n1)"
ck="$(printf '%s' "${HTTP_COOKIE:-}" | tr ';' '\n' | sed -n 's/^ *zp_ui=\(.*\)$/\1/p' | head -n1)"
if [ -n "$tok" ] && [ "$qk" = "$tok" ] && [ "$ck" != "$tok" ]; then
    # Max-Age 一年: 这是"打开过一次就再也不用管"的关键 —— 会话 cookie 一关浏览器就没了,
    # 用户下次打开普通地址又看到"未授权", 只会觉得这东西时好时坏。
    printf 'Set-Cookie: zp_ui=%s; Path=/; Max-Age=31536000; HttpOnly; SameSite=Lax\r\n' "$tok"
fi
ok=""
if [ -n "$tok" ] && { [ "$qk" = "$tok" ] || [ "$ck" = "$tok" ]; }; then ok=1; fi
if [ -z "$ok" ]; then
    sid="$(printf '%s' "${HTTP_COOKIE:-}" | tr ';' '\n' | sed -n 's/^ *sysauth[^=]*=\(.*\)$/\1/p' | head -n1)"
    if [ -n "$sid" ] && command -v ubus >/dev/null 2>&1; then
        ubus -S "$sid" call session get '{}' 2>/dev/null | grep -q '"ubus_rpc_session"' && ok=1
    fi
fi

# ---------------------------------------------------------------- 鉴权
# 先服务"页面本身": 界面也由这个脚本发出 —— GL.iNet 这类固件的 80 端口是
# nginx + fcgiwrap, 静态目录不一定在浏览器能访问的位置 (真机上 /www/zeroproxy/
# 直接 403), 而 /cgi-bin/ 一定通 (LuCI 自己就走这条路)。
# 页面代码不含任何机密, 所以这一段不需要登录。
want="$(printf '%s' "$QS" | tr '&' '\n' | sed -n 's/^file=//p' | head -n1)"
if [ "$want" = "app.js" ]; then
    printf 'Content-Type: text/javascript; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'
    cat /www/zeroproxy/app.js 2>/dev/null
    exit 0
fi
act="$(printf '%s' "$QS" | tr '&' '\n' | sed -n 's/^a=//p' | head -n1)"
if [ -z "$act" ] && [ -z "$want" ]; then
    printf 'Content-Type: text/html; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'
    cat /www/zeroproxy/index.html 2>/dev/null
    exit 0
fi


# 页面与脚本本身不需要授权; 只有下面的数据接口要。
[ -n "$ok" ] || fail "未授权 — 在路由器上执行 zeroproxy ui 拿到带令牌的地址"

# ---------------------------------------------------------------- 工具
BODY="$(cat 2>/dev/null || true)"

jval() {
    if command -v jsonfilter >/dev/null 2>&1; then
        printf '%s' "$BODY" | jsonfilter -e "@.$1" 2>/dev/null | head -n1
    else
        printf '%s' "$BODY" | sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1
    fi
}
# 把任意文本塞进 JSON 字符串 (换行转义成 \n, 由前端还原)
jstr() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\r' | awk '{printf "%s\\n", $0}'; }

# 动作名: /cgi-bin/zeroproxy/add → add (PATH_INFO 或 REQUEST_URI 里取最后一段)
action="$act"
if [ -z "$action" ]; then
    action="$(printf '%s' "${PATH_INFO:-}" | sed -e 's#^/*##' -e 's#/.*$##')"
fi
if [ -z "$action" ]; then
    action="$(printf '%s' "${REQUEST_URI:-}" | sed -e 's/[?].*$//' -e 's#/*$##' -e 's#.*/##')"
fi

run_cli() {
    if [ -x "$CLI" ]; then
        out="$("$CLI" "$@" 2>&1)"
        header
        printf '{"ok":true,"message":"%s"}\n' "$(jstr "$out")"
    else
        fail "路由器上找不到 zeroproxy 命令, 请重跑一次安装命令"
    fi
}

case "$action" in
    status)
        core="stopped"
        /etc/init.d/zeroproxy running >/dev/null 2>&1 && core="running"
        mode="tproxy"
        [ -c /dev/net/tun ] && mode="tun"
        ver=""
        [ -f "$ZP_DIR/version" ] && ver="$(cat "$ZP_DIR/version" 2>/dev/null)"
        items=""
        for f in "$ZP_DIR"/servers/*.json; do
            [ -f "$f" ] || continue
            base="$(sed -n 's/.*"base"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -n1)"
            did="$(sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -n1)"
            key="$(basename "$f" .json)"
            items="${items:+$items,}{\"key\":\"$(jstr "$key")\",\"base\":\"$(jstr "$base")\",\"id\":\"$(jstr "$did")\"}"
        done
        header
        printf '{"ok":true,"core":"%s","mode":"%s","client":"%s","servers":[%s]}\n' \
            "$core" "$mode" "$(jstr "$ver")" "$items"
        ;;
    add)
        url="$(jval url)"
        [ -n "$url" ] || fail "没有收到服务器链接"
        run_cli add "$url"
        ;;
    drop)
        key="$(jval key)"
        [ -n "$key" ] || fail "没有指定要移除的服务器"
        run_cli drop "$key"
        ;;
    toggle)
        on="$(jval on)"
        if [ "$on" = "true" ] || [ "$on" = "1" ]; then run_cli on; else run_cli off; fi
        ;;
    refresh)
        run_cli refresh
        ;;
    log)
        lines="$(logread -e zeroproxy 2>/dev/null | tail -n 60)"
        header
        printf '{"ok":true,"log":"%s"}\n' "$(jstr "$lines")"
        ;;
    *)
        fail "未知操作: $action"
        ;;
esac
