[Unit]
Description=ZeroProxy - Xray Core (VLESS Reality / VLESS WS / Trojan)
After=network-online.target
Wants=network-online.target

[Service]
# 启动前自愈: geo 数据缺失 / 证书丢失等原因让磁盘配置过不了 `xray -test` 时,
# 先按当前状态重新生成配置 (缺数据时自动不下发 geo 规则), 保证核心能起来。
# 前缀 '-' 表示失败也不阻塞 Xray 启动。
Environment=ZP_HOME=/opt/zeroproxy
Environment=PYTHONPATH=/opt/zeroproxy
ExecStartPre=-/opt/zeroproxy/venv/bin/python -m zeroproxy.geodata guard
ExecStart=/usr/local/bin/xray run -c /opt/zeroproxy/xray/config.json
WorkingDirectory=/opt/zeroproxy/xray
# Xray 只从"可执行文件所在目录"或本变量指定的目录加载 geoip.dat / geosite.dat。
# 配置里一旦出现 geoip/geosite 规则而数据缺失, Xray 会拒绝启动整份配置。
Environment=XRAY_LOCATION_ASSET=/opt/zeroproxy/geo
Restart=always
RestartSec=3
LimitNOFILE=1048576

# ---- 沙箱 (P2-13): 不降 User (既有部署的文件属主不变), 只收窄文件系统 ----
# ExecStartPre 的 geodata guard 会重写 /opt/zeroproxy 下的配置, 所以 ZP_HOME 必须可写。
# **不要加 CapabilityBoundingSet**: Xray 的 sockopt / 传输特性会随版本演化用到
# 内核网络能力 (NET_ADMIN 等); 能力收窄的风险大于收益 (v2.12.15 的 Hysteria 就是
# 被同一类收窄弄挂的)。文件系统沙箱与 NoNewPrivileges 仍然保留。
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/zeroproxy
PrivateTmp=yes
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
